# URL of the WPGraphQL endpoint on your WordPress site, e.g. https://your-site.local/graphql
WORDPRESS_API_URL=https://nuttynarrows:8890/graphql

# Public URL of this frontend, used for robots.txt/sitemap.xml. Set this to
# the real domain once deployed, e.g. https://nutty-narrows.vercel.app
SITE_URL=http://localhost:3000

# Slug of the WordPress page used as the site's static front page (Settings
# -> Reading -> "A static page" in wp-admin). This differs per environment
# because each WordPress install named its front-page differently — check
# yours with `wp option get page_on_front` + `wp post list --post_type=page`,
# or just look up the front page's slug in wp-admin.
WORDPRESS_HOME_SLUG=home
